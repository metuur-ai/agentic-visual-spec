{
  "name": "visual-spec",
  "version": "0.1.0",
  "type": "module",
  "description": "Browse any directory in the browser and comment on files, line ranges, and folders, then let an agent apply the comments.",
  "bin": {
    "visual-spec": "dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && node build.mjs",
    "build:ui": "vite build",
    "build:cli": "node build.mjs",
    "dev": "node dev.mjs",
    "dev:ui": "vite",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@visual-spec/core": "workspace:*",
    "esbuild": "^0.28.0",
    "mermaid": "^11.15.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}
