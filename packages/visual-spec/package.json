{
  "name": "@metuur/visual-spec",
  "version": "0.1.7",
  "type": "module",
  "description": "Browse any directory in the browser and comment on files, line ranges, and folders, then let an agent apply the comments.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "visual-spec": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./editing": {
      "types": "./dist/editing/index.d.ts",
      "default": "./dist/editing/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && vite build && node build.mjs",
    "build:lib": "tsup",
    "build:ui": "vite build",
    "build:cli": "node build.mjs",
    "check:bundle": "node check-bundle.mjs",
    "dev": "node dev.mjs",
    "dev:ui": "vite",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "vite": "^5 || ^6"
  },
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "@lyfie/luthor": "2.9.0",
    "ignore": "^7.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__traverse": "^7.20.0",
    "@types/node": "^20.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.0",
    "jsdom": "^26.1.0",
    "mermaid": "^11.15.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
